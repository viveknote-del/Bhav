# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/bhav

# ── Redis (queue + cache) ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6381

# ── API ─────────────────────────────────────────────────────────────────────
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Market data provider ────────────────────────────────────────────────────
# Supported:
#   yfinance      — default, no key, may be blocked by Yahoo on cloud IPs
#   alphavantage  — needs key, free tier 25/day (test only, can't run daily scans)
#   twelvedata    — needs key, free tier 800/day (good for daily scans of NIFTY 50)
MARKET_DATA_PROVIDER=yfinance

# Only needed if MARKET_DATA_PROVIDER=alphavantage.
# Free key: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Only needed if MARKET_DATA_PROVIDER=twelvedata.
# Free key: https://twelvedata.com/register
TWELVEDATA_API_KEY=

# ── Scan configuration ──────────────────────────────────────────────────────
# Universe: NIFTY_50 | NSE_500 | NSE_ALL
SCAN_UNIVERSE=NSE_500
# Set to true to enable the 5-min intraday loop during market hours
INTRADAY_ENABLED=false
# Top N breakouts per scan that receive AI commentary
COMMENTARY_TOP_N=20

# ── AI (Claude) ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Model used for commentary + EOD digest
LLM_MODEL=claude-sonnet-4-6

# ── News ────────────────────────────────────────────────────────────────────
# Get a key at https://newsapi.org/ (free tier: 100 req/day)
NEWSAPI_KEY=

# ── Alerts (Step 7, optional) ───────────────────────────────────────────────
# Set these to enable Telegram alerts on high-conviction breakouts.
# Create a bot via @BotFather, then send it a message and grab your chat ID
# from https://api.telegram.org/bot<TOKEN>/getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_MIN_SCORE=80
