# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bhav

# ── Redis (queue + cache) ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API ─────────────────────────────────────────────────────────────────────
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Market data provider ────────────────────────────────────────────────────
# Supported: yfinance (only impl in v1)
MARKET_DATA_PROVIDER=yfinance

# ── Scan configuration ──────────────────────────────────────────────────────
# Universe: NIFTY_50 | NSE_500 | NSE_ALL
SCAN_UNIVERSE=NSE_500
# Set to true to enable the 5-min intraday loop during market hours
INTRADAY_ENABLED=false
# Top N breakouts per scan that receive AI commentary
COMMENTARY_TOP_N=20

# ── AI (Claude) ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Model used for commentary + EOD digest
LLM_MODEL=claude-sonnet-4-6

# ── News ────────────────────────────────────────────────────────────────────
# Get a key at https://newsapi.org/ (free tier: 100 req/day)
NEWSAPI_KEY=

# ── Alerts (Step 7, optional) ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_MIN_SCORE=80
